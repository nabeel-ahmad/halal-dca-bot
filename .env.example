# Copy this to .env for LOCAL testing only — never commit a real .env file.
# In production, set these as GitHub Actions encrypted secrets instead
# (Settings > Secrets and variables > Actions), not as plain repo files.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# SMTP (sending the proposal email) — e.g. Gmail: smtp.gmail.com, port 587,
# use an App Password, not your real account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# IMAP (polling for your yes/no reply) — same provider, different host/port,
# e.g. Gmail: imap.gmail.com, port 993. Same SMTP_USER/SMTP_PASSWORD are reused to log in.
IMAP_HOST=
IMAP_PORT=993

DRY_RUN=true
MAX_ORDER_USD=200
MAX_TOTAL_USD_PER_RUN=1000
MONTHLY_CONTRIBUTION_USD=500
UNIVERSE_FILE=halal_universe.csv
APPROVAL_TIMEOUT_SECONDS=1800
