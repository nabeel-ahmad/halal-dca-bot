# Copy this to .env for LOCAL testing only — never commit a real .env file.
# In production, set these as GitHub Actions encrypted secrets instead
# (Settings > Secrets and variables > Actions), not as plain repo files.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# SMTP (sending the weekly review email) — e.g. Gmail: smtp.gmail.com, port
# 587, use an App Password, not your real account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Weekly portfolio review tuning (all optional, shown with their defaults).
CONCENTRATION_WARN_PCT=30
CASH_RESERVE_TARGET_USD=500
NUM_STOCK_PICKS=7
NUM_ETF_PICKS=3
